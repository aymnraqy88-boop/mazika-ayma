name: Build Mazika Ayman APK
on:
  workflow_dispatch:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
      - name: Install Gradle
        run: |
          wget -q https://services.gradle.org/distributions/gradle-8.9-bin.zip -O /tmp/gradle.zip
          unzip -q /tmp/gradle.zip -d /tmp
          echo /tmp/gradle-8.9/bin >> "$GITHUB_PATH"
      - name: Extract project
        run: unzip -q Mazika_Ayman_Android_Project.zip
      - name: Build APK
        working-directory: Mazika_Ayman_Android_Project
        run: gradle assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        if: success()
        with:
          name: Mazika-Ayman-APK
          path: Mazika_Ayman_Android_Project/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
